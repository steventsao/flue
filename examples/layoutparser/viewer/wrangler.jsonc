{
	// Static-assets-only Worker: serves the built Vite app at a public URL.
	// The app calls the separate LayoutParser API Worker over CORS.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "flue-layoutparser-viewer",
	"compatibility_date": "2026-06-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
